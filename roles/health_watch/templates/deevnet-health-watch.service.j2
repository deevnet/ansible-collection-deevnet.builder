# {{ ansible_managed }}
[Unit]
Description=Check that the substrate is running (INC-0007)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ health_watch_user }}
Group={{ health_watch_user }}
ExecStart={{ health_watch_script }} --config {{ health_watch_config }}
# A run is seconds: one SSH call per host, in parallel, and a few HTTPS calls.
TimeoutStartSec=120
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ health_watch_home }} {{ health_watch_report_dir }}
ProtectHome=true
PrivateTmp=true
