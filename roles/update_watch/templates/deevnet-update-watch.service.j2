# {{ ansible_managed }}
[Unit]
Description=Report the updates waiting on the substrate (Patch Management v2)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ update_watch_user }}
Group={{ update_watch_user }}
ExecStart={{ update_watch_script }} --config {{ update_watch_config }}
# A run is a minute or two: one SSH call per host, a few HTTPS calls.
TimeoutStartSec=900
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ update_watch_home }} {{ update_watch_report_dir }}
ProtectHome=true
PrivateTmp=true
