#!/usr/bin/python3
"""deevnet-update-watch - report what updates are waiting (Patch Management v2).

Once a day, as the deevnet-watch account on the Builder:
  - every substrate host is asked, over SSH, what updates it has waiting. The
    key is pinned on each host to one read-only program, deevnet-watch-check,
    asked here for its "updates" check;
  - the Omada controller is asked, with a view-only client, whether its devices
    have newer firmware;
  - OPNsense's published releases are compared with the version the newest
    discovery report saw on the core router. The router itself is not asked:
    its only firmware privilege could also install updates.

It writes, in report_dir:
  latest.txt         everything waiting now, every run;
  latest.json        the same as data, every run: each host's waiting packages
                     with their class and security advisories, and its OS
                     release's end of life. Read by deevnet-patch-mcp;
  YYYY-MM-DD.txt     what was new that day: a security update, a host with
                     updates waiting that had none, a new OPNsense release or
                     device firmware, a system that stopped answering, and a
                     reminder for anything waiting longer than remind_days;
  notice             a scoreboard a login banner shows while anything new has
                     not been acknowledged: per system, how many updates wait,
                     major, minor and security, the systems with news marked
                     "new". Empty when there is nothing new.
Ordinary package churn on a host already behind is in latest.txt but is not
news. Nothing leaves the Builder: no mail, no network but the questions.

    deevnet-update-watch --config /etc/deevnet/update-watch.json [--dry-run | --ack]

--dry-run prints what it would write and leaves everything alone.
--ack     clears the notice: the operator has read the report.
"""
import argparse
import datetime
import json
import os
import re
import ssl
import subprocess
import sys
import urllib.request

# --- Reading what a host said ----------------------------------------------------


def sections(text):
    out, cur = {}, None
    for line in (text or "").splitlines():
        if line.startswith("### "):
            cur = line[4:].strip()
            out[cur] = []
        elif cur:
            out[cur].append(line)
    return {k: "\n".join(v) for k, v in out.items()}


def kv(text, sep="="):
    out = {}
    for line in (text or "").splitlines():
        if sep in line:
            k, v = line.split(sep, 1)
            out[k.strip()] = v.strip().strip('"')
    return out


def nevra_name(nevra):
    """acl-2.4.0-1.fc43.x86_64 -> acl; NetworkManager-1:1.54.3-3.fc43.x86_64 -> NetworkManager."""
    parts = nevra.rsplit("-", 2)
    return parts[0] if len(parts) == 3 else nevra


def parse_check(text, now):
    """deevnet-watch-check updates' output -> {os, updates: [{name, version, installed, security}], cache_days, error}.

    installed is the version the update replaces, or "" when the host's check
    does not say (an older check, or a package new to the host)."""
    s = sections(text)
    osr = kv(s.get("os"))
    res = {"os": osr.get("PRETTY_NAME", ""), "updates": [], "cache_days": None, "error": s.get("error", "").strip()}
    if "dnf-check-upgrade" in s:
        lines = s["dnf-check-upgrade"].splitlines()
        rc = kv(lines[0]).get("rc", "") if lines else ""
        if rc not in ("0", "100"):
            res["error"] = "dnf check-upgrade failed: " + " ".join(lines[1:])[:300]
        advisories = {}  # package name -> [{id, severity}]
        try:
            for a in json.loads(s.get("dnf-security") or "[]"):
                advisories.setdefault(nevra_name(a.get("nevra", "")), []).append(
                    {"id": a.get("name"), "severity": a.get("severity") or None})
        except ValueError:
            pass
        installed = {}
        for line in (s.get("rpm-installed") or "").splitlines():
            f = line.split()
            if len(f) == 2:
                installed[f[0]] = f[1]  # name.arch -> epoch:version-release
        for line in lines[1:]:
            if not line.strip():
                break  # "Obsoleting packages" follows a blank line
            f = line.split()
            if len(f) == 3:
                name = f[0].rsplit(".", 1)[0]
                res["updates"].append({"name": name, "version": f[1], "installed": installed.get(f[0], ""),
                                       "security": name in advisories,
                                       "advisories": advisories.get(name, [])})
    elif "apt-upgradable" in s:
        for line in s["apt-upgradable"].splitlines():
            f = line.split()
            if "/" not in (f[0] if f else "") or len(f) < 2:
                continue  # "Listing..." and blanks
            name, suites = f[0].split("/", 1)
            m = re.search(r"\[upgradable from: ([^\]]+)\]", line)
            sec = "-security" in suites
            res["updates"].append({"name": name, "version": f[1], "installed": m.group(1) if m else "",
                                   "security": sec,
                                   # Debian's security suite names no advisory or severity here.
                                   "advisories": [{"id": None, "severity": None}] if sec else []})
    age = (s.get("cache-age") or "").strip()
    if age:
        try:
            res["cache_days"] = round((now.timestamp() - float(age)) / 86400, 1)
        except ValueError:
            pass
    return res


# --- Asking -----------------------------------------------------------------------


def ask_host(cfg, target):
    """(text, error): the host's check output, or why it could not be had."""
    if target["name"] == cfg["self"]:
        argv = [cfg["check"], "updates"]
    else:
        argv = ["ssh", "-i", cfg["ssh_key"], "-o", "BatchMode=yes", "-o", "ConnectTimeout=15",
                "-o", "StrictHostKeyChecking=accept-new", "-o", "IdentitiesOnly=yes",
                f"{cfg['ssh_user']}@{target['address']}", "updates"]
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.TimeoutExpired) as e:
        return None, str(e)
    if p.returncode != 0 or "### os" not in p.stdout:
        return None, (p.stderr.strip() or f"exit {p.returncode}")[:300]
    return p.stdout, None


def http_json(url, data=None, headers=None, verify=True, timeout=30):
    ctx = ssl.create_default_context()
    if not verify:
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(url, data=body, method="POST" if body else "GET",
                                 headers={"Content-Type": "application/json",
                                          "User-Agent": "deevnet-update-watch", **(headers or {})})
    with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
        return json.load(r)


def ask_omada(cfg):
    """([{host, item, current, latest}], error) for the devices the controller manages."""
    o = cfg.get("omada") or {}
    if not o.get("url") or not o.get("client_id"):
        return [], None  # not configured: noted in the summary, not a failure
    v = o.get("verify", True)
    try:
        # omada-api: UNDOCUMENTED /api/info tested-on 6.3.0.45
        cid = http_json(f"{o['url']}/api/info", verify=v)["result"]["omadacId"]
        # omada-api: documented authorize/token (TP-Link Open API guide) spec 6.3.0.45
        tok = http_json(f"{o['url']}/openapi/authorize/token?grant_type=client_credentials",
                        {"omadacId": cid, "client_id": o["client_id"], "client_secret": o["client_secret"]},
                        verify=v)
        if tok.get("errorCode") != 0:
            return [], f"Omada token refused (errorCode {tok.get('errorCode')})"
        hdr = {"Authorization": "AccessToken=" + tok["result"]["accessToken"]}
        api = f"{o['url']}/openapi/v1/{cid}"
        out = []
        # omada-api: documented getSiteList, getSiteDeviceList, getFirmwareInfo spec 6.3.0.45
        for site in http_json(f"{api}/sites?page=1&pageSize=100", headers=hdr, verify=v)["result"]["data"]:
            sid = site["siteId"]
            for d in http_json(f"{api}/sites/{sid}/devices?page=1&pageSize=100", headers=hdr, verify=v)["result"]["data"]:
                fw = http_json(f"{api}/sites/{sid}/devices/{d['mac']}/latest-firmware-info",
                               headers=hdr, verify=v).get("result") or {}
                cur, last = fw.get("curFwVer", ""), fw.get("lastFwVer", "")
                if last and cur and last != cur:
                    out.append({"host": d.get("name") or d["mac"], "item": f"{d.get('model', '')} firmware",
                                "current": cur, "latest": last, "src": "Omada"})
        return out, None
    except Exception as e:  # noqa: BLE001 - any failure is reported, not raised
        return [], f"Omada: {e}"


def vtuple(v):
    return tuple(int(x) for x in v.split("."))


def ask_opnsense(cfg, tags=None):
    """([{host, item, current, latest, kind}], error): OPNsense releases newer than the router's."""
    o = cfg.get("opnsense") or {}
    d = o.get("discovery_dir", "")
    try:
        reports = sorted(f for f in os.listdir(d) if re.fullmatch(r"\d{4}-\d{2}-\d{2}\.json", f))
    except OSError as e:
        return [], f"no discovery reports: {e}"
    if not reports:
        return [], "no discovery report yet: run make discover"
    rep = json.load(open(os.path.join(d, reports[-1]), encoding="utf-8"))
    router, installed = None, None
    for host, rows in rep.get("hosts", {}).items():
        for r in rows:
            if r.get("item") == "OPNsense" and r.get("observed"):
                router, installed = host, r["observed"]
    if not installed:
        return [], f"the discovery report of {reports[-1][:10]} has no OPNsense version"
    base = re.match(r"\d+(\.\d+)+", installed)
    if not base:
        return [], f"cannot read OPNsense version {installed!r}"
    have = vtuple(base.group(0))
    if tags is None:
        try:
            tags = [t["name"] for t in http_json(o["tags_url"])]
        except Exception as e:  # noqa: BLE001
            return [], f"OPNsense releases: {e}"
    stable = sorted({vtuple(t) for t in tags if re.fullmatch(r"\d+\.\d+(\.\d+)?", t)})
    series = have[:2]
    out = []
    same = [t for t in stable if t[:2] == series and t > have]
    if same:
        out.append({"host": router, "item": "OPNsense", "current": installed,
                    "latest": ".".join(map(str, same[-1])), "kind": "point release", "src": "OPNsense releases"})
    newer = [t for t in stable if t[:2] > series]
    if newer:
        line = max(t[:2] for t in newer)
        out.append({"host": router, "item": "OPNsense", "current": installed,
                    "latest": ".".join(map(str, line)), "kind": "new release line", "src": "OPNsense releases"})
    return out, None


# --- Deciding what is news --------------------------------------------------------


def iso(dt):
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(s):
    return datetime.datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)


def evaluate(state, hosts, extras, failures, now, remind_days):
    """Update state in place; return the 'what is new' lines, empty when nothing is.

    hosts:    {name: parsed check} for hosts that answered and are reported on
    extras:   [{host, item, current, latest, kind?}] from Omada and OPNsense
    failures: {name: error} for whatever did not answer
    """
    items = state.setdefault("items", {})
    down = state.setdefault("down", {})
    news, current = [], set()

    def note(key, src):
        """'new', 'remind' or None, and the record kept for the key."""
        current.add(key)
        rec = items.get(key)
        if rec is None:
            items[key] = {"first_seen": iso(now), "last_mailed": iso(now), "src": src}
            return "new"
        if (now - parse_iso(rec["last_mailed"])).days >= remind_days:
            rec["last_mailed"] = iso(now)
            return "remind"
        return None

    def waited(key):
        return (now - parse_iso(items[key]["first_seen"])).days

    for name, h in sorted(hosts.items()):
        ups = h["updates"]
        if ups:
            k = f"{name}|any"
            st = note(k, name)
            if st == "new":
                news.append(f"{name}: updates waiting ({len(ups)})")
            elif st == "remind":
                news.append(f"{name}: updates waiting ({len(ups)}), the oldest for {waited(k)} days")
        new_sec, old_sec = [], []
        for u in ups:
            if u["security"]:
                st = note(f"{name}|sec|{u['name']}|{u['version']}", name)
                (new_sec if st == "new" else old_sec if st == "remind" else []).append(u["name"])
        for label, names in (("new security updates", new_sec), ("security updates still waiting after "
                                                                  f"{remind_days} days", old_sec)):
            if names:
                names = sorted(set(names))
                more = f" and {len(names) - 20} more" if len(names) > 20 else ""
                news.append(f"{name}: {len(names)} {label}: {', '.join(names[:20])}{more}")
    for e in extras:
        kind = f" ({e['kind']})" if e.get("kind") else ""
        k = f"{e['host']}|{e['item']}|{e['latest']}"
        st = note(k, e.get("src", e["host"]))
        line = f"{e['host']}: {e['item']} {e['latest']} is out{kind}; running {e['current']}"
        if st == "new":
            news.append(line)
        elif st == "remind":
            news.append(f"{line} (still waiting, {waited(k)} days)")

    # Gone from what is waiting: applied, or superseded. Forget it, so it is
    # news again if it ever comes back.
    for key in [k for k in items if k not in current]:
        # A host or source that did not answer keeps its items: nothing is known
        # about them today.
        if items[key].get("src", key.split("|", 1)[0]) not in failures:
            del items[key]

    for name, err in sorted(failures.items()):
        if name not in down:
            down[name] = iso(now)
            news.append(f"{name}: did not answer ({err})")
    for name in [n for n in down if n not in failures]:
        del down[name]
    return news


def summary(hosts, unmailed, extras, failures, notes=()):
    lines = []
    for name, h in sorted({**hosts, **unmailed}.items()):
        ups = h["updates"]
        sec = sorted({u["name"] for u in ups if u["security"]})
        tail = " (not news: Proxmox VE mails its own)" if name in unmailed else ""
        stale = f"; package cache {h['cache_days']} days old" if (h.get("cache_days") or 0) > 3 else ""
        err = f"; {h['error']}" if h.get("error") else ""
        if not ups:
            lines.append(f"  {name}: up to date ({h['os']}){stale}{err}{tail}")
            continue
        s = f", {len(sec)} security: {', '.join(sec[:15])}{' ...' if len(sec) > 15 else ''}" if sec else ""
        lines.append(f"  {name}: {len(ups)} waiting{s} ({h['os']}){stale}{err}{tail}")
    for e in extras:
        lines.append(f"  {e['host']}: {e['item']} {e['current']} -> {e['latest']}")
    for name, err in sorted(failures.items()):
        lines.append(f"  {name}: no answer ({err})")
    lines += [f"  {n}" for n in notes]
    return lines


def headline(hosts, extras, failures):
    n_sec = sum(1 for h in hosts.values() for u in h["updates"] if u["security"])
    behind = {n for n, h in hosts.items() if h["updates"]} | {e["host"] for e in extras}
    n_up = sum(len(h["updates"]) for h in hosts.values()) + len(extras)
    line = f"{n_up} updates waiting on {len(behind)} systems"
    if n_sec:
        line += f", {n_sec} security"
    if failures:
        line += f", {len(failures)} not answering"
    return line


def report(cfg, title, news, hosts, unmailed, extras, failures, now, notes=()):
    body = [title, "", *scoreboard(cfg, {**hosts, **unmailed}, extras, failures), ""]
    if news:
        body += ["New:", *[f"  {x}" for x in news], ""]
    body += ["Everything waiting now:", *summary(hosts, unmailed, extras, failures, notes), "",
             f"Checked {iso(now)} by deevnet-update-watch on {cfg['self']}.",
             "Applying them is the monthly patch cycle; see the runbook's Patching page.", ""]
    return "\n".join(body)


# --- The scoreboard ----------------------------------------------------------------


def upstream(v):
    """(epoch, first version field): "1:1.54.3-3.fc43" -> ("1", "1"); "7.3.4-100.fc43" -> ("0", "7")."""
    v = v.strip()
    epoch, _, rest = v.rpartition(":") if re.match(r"\d+:", v) else ("0", "", v)
    m = re.match(r"[0-9]+|[A-Za-z]+", rest)
    return epoch or "0", (m.group(0) if m else rest)


def classify(installed, version):
    """'major' when the epoch or the first version field changes, 'minor' for any
    other update, None when the installed version is not known. Two kinds of
    first field move on every release without meaning more, and are minor:
    a date or a year, four or more digits (linux-firmware 20251021, tzdata
    2025b), and a version that is one number alone (less 704, ndctl 82)."""
    if not installed:
        return None
    (e1, f1), (e2, f2) = upstream(installed), upstream(version)
    if e1 != e2:
        return "major"
    if f1 == f2 or (len(f1) >= 4 and f1.isdigit() and len(f2) >= 4 and f2.isdigit()):
        return "minor"
    if single_number(installed) and single_number(version):
        return "minor"
    return "major"


def single_number(v):
    """True for a version that is one number and nothing else, before its release:
    "0:704-4.fc44" and "710-2.fc44" are; "6.17.1-300.fc43" is not."""
    rest = v.strip().split(":", 1)[-1] if re.match(r"\d+:", v.strip()) else v.strip()
    up = rest.rsplit("-", 1)[0] if "-" in rest else rest
    return up.isdigit()


def tally(updates):
    t = {"major": 0, "minor": 0, "security": 0, "unknown": 0}
    for u in updates:
        t[classify(u.get("installed", ""), u["version"]) or "unknown"] += 1
        t["security"] += bool(u["security"])
    return t


def scoreboard(cfg, results, extras, failures, marked=frozenset()):
    """The table of what waits where: a row per system, grouped by kind.

    Major and Minor count every update by how far it moves (they add up to all
    of them); Security counts those that fix a security advisory, of either.
    results: {name: parsed check} for every host that answered
    marked:  names with something not yet acknowledged, flagged "new"
    """
    w = max([len(t["name"]) for t in cfg["targets"]] + [len(e["host"]) for e in extras] + [13]) + 2
    head = f"{'':<{w}}{'Major':>6}{'Minor':>7}{'Security':>10}"
    lines, total, unknown = [head], {"major": 0, "minor": 0, "security": 0}, 0

    def cells(t):
        return "".join(f"{(t[k] or '-')!s:>{n}}" for k, n in (("major", 6), ("minor", 7), ("security", 10)))

    def flag(name):
        return "  new" if name in marked else "     "

    kinds = list(cfg.get("kinds") or [])
    for t in cfg["targets"]:
        if t.get("kind", "Other") not in kinds:
            kinds.append(t.get("kind", "Other"))
    for kind in kinds:
        rows = [t["name"] for t in cfg["targets"] if t.get("kind", "Other") == kind]
        if not rows:
            continue
        lines.append(kind)
        for name in rows:
            if name in failures:
                lines.append(f"  {name:<{w - 2}}{'no answer':>23}{flag(name)}".rstrip())
                continue
            if name not in results:
                continue
            t = tally(results[name]["updates"])
            for k in total:
                total[k] += t[k]
            unknown += t["unknown"]
            extra = f"  ({t['unknown']} unsorted)" if t["unknown"] else ""
            lines.append(f"  {name:<{w - 2}}{cells(t)}{flag(name)}{extra}".rstrip())
    net = [e for e in extras] + [{"host": n} for n in ("OPNsense releases", "Omada") if n in failures]
    if net:
        lines.append("Network")
        for e in net:
            if "item" not in e:
                lines.append(f"  {e['host']:<{w - 2}}{'not checked':>23}{flag(e['host'])}".rstrip())
                continue
            major = e.get("kind") == "new release line" or (
                e.get("kind") != "point release" and classify(e["current"], e["latest"]) == "major")
            t = {"major": int(major), "minor": int(not major), "security": 0}
            for k in total:
                total[k] += t[k]
            lines.append(f"  {e['host']:<{w - 2}}{cells(t)}{flag(e['host'])}  {e['item']} {e['latest']}")
    lines.append(f"{'Total':<{w}}{cells(total)}")
    if unknown:
        lines.append(f"{unknown} not sorted into major or minor: the host's check does not say what is installed")
    return lines


def notice_text(state, report_dir, board=()):
    """The banner, from what is pending: empty when nothing is."""
    pending = state.get("pending") or []
    if not pending:
        return ""
    first = min(p["date"] for p in pending)
    lines = [f"Deevnet updates waiting ({len(pending)} new since {first})", "", *board, "",
             f"Read {report_dir}/latest.txt; clear this with: make update-watch-ack (deevnet.builder)"]
    width = max(len(x) for x in lines)
    bar = "=" * min(width, 100)
    return "\n".join([bar, *lines, bar]) + "\n"


def as_json(cfg, hosts, unmailed, extras, failures, notes, state, now):
    """Everything the run found, for tools to read (deevnet-patch-mcp): latest.txt as data."""
    eol = cfg.get("eol") or {}
    kinds = {t["name"]: t.get("kind", "Other") for t in cfg["targets"]}
    out = {}
    for name, h in {**hosts, **unmailed}.items():
        rel = re.sub(r"\s*\(.*\)$", "", h["os"]).strip()  # "Fedora Linux 43 (Forty Three)" -> "Fedora Linux 43"
        out[name] = {
            "kind": kinds.get(name, "Other"), "os": h["os"], "os_release": rel, "os_eol": eol.get(rel),
            "news": name in hosts, "answered": True, "error": h.get("error") or None,
            "cache_days": h.get("cache_days"),
            "updates": [dict(u, **{"class": classify(u.get("installed", ""), u["version"])}) for u in h["updates"]],
        }
    for name, err in failures.items():
        if name in kinds:
            out[name] = {"kind": kinds[name], "answered": False, "error": err, "updates": []}
    return json.dumps({
        "version": 1, "checked_at": iso(now), "self": cfg["self"], "kinds": cfg.get("kinds", []),
        "hosts": out, "network": extras,
        "failures": {k: v for k, v in failures.items() if k not in kinds},
        "notes": list(notes), "pending": state.get("pending") or [], "eol": eol,
    }, indent=1, sort_keys=True) + "\n"


def write(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


# --- Running ----------------------------------------------------------------------


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--config", default="/etc/deevnet/update-watch.json")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--dry-run", action="store_true")
    g.add_argument("--ack", action="store_true")
    a = ap.parse_args()
    cfg = json.load(open(a.config, encoding="utf-8"))
    rdir = cfg["report_dir"]
    now = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
    state_path = cfg["state"]
    try:
        state = json.load(open(state_path, encoding="utf-8"))
    except (OSError, ValueError):
        state = {}

    if a.ack:
        n = len(state.get("pending") or [])
        state["pending"] = []
        write(state_path, json.dumps(state, indent=1, sort_keys=True))
        write(os.path.join(rdir, "notice"), "")
        print(f"acknowledged {n}; the banner is clear")
        return 0

    hosts, unmailed, failures = {}, {}, {}
    for t in cfg["targets"]:
        text, err = ask_host(cfg, t)
        if err:
            failures[t["name"]] = err
            continue
        parsed = parse_check(text, now)
        if parsed["error"] and not parsed["updates"]:
            # It answered but could not check: not "up to date", unknown.
            failures[t["name"]] = f"answered, but could not check: {parsed['error']}"
            continue
        (hosts if t.get("news", True) else unmailed)[t["name"]] = parsed
    extras, notes = [], []
    if not (cfg.get("omada") or {}).get("client_id"):
        notes.append("Omada devices not checked: no view-only client configured")
    for source, (found, err) in (("Omada", ask_omada(cfg)), ("OPNsense releases", ask_opnsense(cfg))):
        extras += found
        if err:
            failures[source] = err

    news = evaluate(state, hosts, extras, failures, now, int(cfg.get("remind_days", 30)))
    day = now.strftime("%Y-%m-%d")
    state.setdefault("pending", []).extend({"date": day, "line": x} for x in news)
    title = headline(hosts, extras, failures)
    latest = report(cfg, title, [], hosts, unmailed, extras, failures, now, notes)
    dated = report(cfg, title, news, hosts, unmailed, extras, failures, now, notes) if news else None
    marked = {p["line"].split(":", 1)[0] for p in state["pending"]}
    notice = notice_text(state, rdir, scoreboard(cfg, {**hosts, **unmailed}, extras, failures, marked))
    data = as_json(cfg, hosts, unmailed, extras, failures, notes, state, now)

    if a.dry_run:
        print(f"--- {rdir}/notice\n{notice or '(empty)'}")
        print(f"--- {rdir}/{day}.txt\n{dated or '(not written: nothing new)'}")
        print(f"--- {rdir}/latest.json: {len(data)} bytes, {len(json.loads(data)['hosts'])} hosts")
        return 0
    write(os.path.join(rdir, "latest.txt"), latest)
    write(os.path.join(rdir, "latest.json"), data)
    if dated:
        path = os.path.join(rdir, f"{day}.txt")
        prior = open(path, encoding="utf-8").read() + "\n" if os.path.exists(path) else ""
        write(path, prior + dated)
    write(os.path.join(rdir, "notice"), notice)
    write(state_path, json.dumps(state, indent=1, sort_keys=True))
    print(f"{len(news)} new; {len(state['pending'])} pending in the notice")
    return 0


if __name__ == "__main__":
    sys.exit(main())
